APP_ENV=development
DATABASE_URL=postgresql+psycopg://stayops:stayops@localhost:5432/stayops
MOCK_DATABASE_URL=postgresql+psycopg://stayops:stayops@localhost:5433/stayops_mock
MOCK_EMBEDDING_CACHE_PATH=.cache/mock_embeddings.sqlite3
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:3000"]
DOCUMENT_STORAGE_ROOT=data/uploads
DOCUMENT_MAX_UPLOAD_BYTES=10485760
DOCUMENT_MAX_EXTRACTED_CHARACTERS=500000
DOCUMENT_CHUNK_CHARACTERS=1600
DOCUMENT_CHUNK_OVERLAP=200

OPENROUTER_API_KEY=
OPENROUTER_CHAT_API_KEY=
OPENROUTER_EMBEDDING_API_KEY=
OPENROUTER_CHAT_MODEL=openai/gpt-5-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=http://localhost:8000
OPENROUTER_APP_TITLE=StayOps AI
OPENROUTER_CHAT_TEMPERATURE=0.1
OPENROUTER_CHAT_MAX_TOKENS=600
OPENROUTER_TIMEOUT_SECONDS=30
SEMANTIC_RISK_THRESHOLD=0.80
